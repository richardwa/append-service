# HTTP server
PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=messages
PGUSER=postgres
PGPASSWORD=postgres

# MQTT broker
MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
MQTT_CLIENT_ID=append-service
# Topic filter to subscribe to ("#" = everything)
MQTT_TOPIC=#
# Quality of service for the subscription (0, 1 or 2)
MQTT_QOS=1
