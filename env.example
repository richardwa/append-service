# HTTP listener
PORT=8401

# Embedded MQTT broker listener (the service IS the broker)
MQTT_PORT=1883

# Database mode: "postgres" (production) or "memory" (embedded pg-mem, dev/testing)
DB_MODE=postgres

# PostgreSQL (only used when DB_MODE=postgres). The sensors.messages table
# and user grants are owned by the my-db deployment init scripts.
PGHOST=host.containers.internal
PGPORT=5432
PGDATABASE=home
PGUSER=sensors_rw
PGPASSWORD=CHANGE_ME_RW
PGSCHEMA=sensors
